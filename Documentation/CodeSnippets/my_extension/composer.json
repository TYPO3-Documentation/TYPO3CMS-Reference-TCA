{
  "name": "myvendor/my-extension",
  "description": "Conference extension, the example extension of the TCA Reference",
  "license": "GPL-2.0-or-later",
  "type": "typo3-cms-extension",
  "require": {
    "typo3/cms-backend": "^14.3",
    "typo3/cms-core": "^14.3",
    "typo3/cms-extbase": "^14.3",
    "typo3/cms-frontend": "^14.3"
  },
  "autoload": {
    "psr-4": {
      "MyVendor\\MyExtension\\": "Classes/"
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "my_extension",
      "version": "1.0.0",
      "Package": {
        "providesPackages": {}
      }
    }
  }
}
